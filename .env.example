# ==============================================================================
# EduVault Production Configuration Template
# Copy this file to .env and fill in your secrets before starting the server.
# ==============================================================================

# Server Environment ('production' or 'development')
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# Enterprise Security & Cryptography
# Generate a secure 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=eduvault_prod_super_secure_secret_key_change_me_in_production_894729103
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Engine
# Default: Embedded production-tuned SQLite (WAL mode, zero external setup)
DATABASE_URL=sqlite:///backend/eduvault.db
# PostgreSQL Alternative (Render, Neon, Supabase, AWS RDS):
# DATABASE_URL=postgresql://user:password@hostname:5432/eduvault

# Multi-Provider AI LLM Integration (Optional)
# If provided, EduVault uses live models for smart catch-up summaries & AI doubt tutor.
# If omitted, EduVault automatically uses its built-in local heuristic synthesis engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Configuration
# Comma-separated list of allowed web origins, or '*' for public access
ALLOWED_ORIGINS=*

# Logging Level (INFO, WARNING, ERROR, DEBUG)
LOG_LEVEL=INFO
